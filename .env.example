# 믿집 환경변수 예시. 복사해서 .env 로 쓰세요. 실제 키와 비밀번호는 .env 에만 둡니다.

# ── 데이터베이스 (PostgreSQL) ──
POSTGRES_DB=mitjip
POSTGRES_USER=mitjip
# 로컬용 아무 값. EC2에서는 길고 무작위인 값으로 바꾸세요.
POSTGRES_PASSWORD=change-me-local

# ── 로컬 개발 포트 (내 PC 쪽) ──
# PC에 PostgreSQL이 이미 깔려 있으면 5432가 겹쳐서 기본값을 5433으로 둡니다.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# ── 실행 환경 ──
# local / staging / production
APP_ENV=local
# EC2에서만 씀: Caddy가 HTTPS 인증서를 받을 도메인 (예: mitjip.example.com)
DOMAIN=localhost
# 로그인한 사람의 쿠키로 상태를 바꾸는 요청을 받아 줄 화면 주소 (쉼표로 구분). EC2에서는 compose.prod.yaml이 https://DOMAIN 으로 정한다
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# ── AI ──
# false면 LLM을 부르지 않고 스텁 응답을 씁니다 (유료 호출 0회). CI는 항상 false.
LLM_LIVE=false
# 공급자와 모델은 팀 결정(R14) 후에 채웁니다.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ── 공공데이터 (아직 코드에서 안 씀) ──
# 공공데이터포털 인증키: 건축HUB 건축물대장, 국세청 사업자 상태, 조달청 가격정보
DATA_GO_KR_KEY=
# 도로명주소 API 승인키
JUSO_CONFM_KEY=
